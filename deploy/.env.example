# F Cartel production settings (deploy/README.md). setup.sh creates .env from
# this file and fills in the generated secrets; you add the rest. Keep .env
# private (chmod 600) — it holds every secret of the installation.

# ── Where it runs ──────────────────────────────────────────────────────────
FCARTEL_DOMAIN=fcartel.divtech.cloud
# Loopback port nginx forwards to. Must be free on this server.
FCARTEL_PORT=3095
# Email for the Let's Encrypt certificate (expiry warnings go here).
LETSENCRYPT_EMAIL=

# ── Which version runs ─────────────────────────────────────────────────────
# Image tag published by GitHub Actions (e.g. sha-1a2b3c4). Only set by hand
# for the first install; afterwards Admin → Releases updates it.
FCARTEL_VERSION=
FCARTEL_IMAGE_PREFIX=ghcr.io/ganatradeep

# ── Pulling the private images from GitHub Container Registry ──────────────
# A GitHub personal access token (classic) with the read:packages scope.
REGISTRY_SERVER=ghcr.io
REGISTRY_USERNAME=GanatraDeep
REGISTRY_TOKEN=

# ── Platform ───────────────────────────────────────────────────────────────
# Sign up with this email to get the Admin console (/admin).
SUPER_ADMIN_EMAILS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# WhatsApp OTP for guests ordering from a table QR code (new numbers only).
# Leave either empty to skip the OTP (guests still give name + number).
WHATSAPP_API_URL=https://divtech.cloud/send-unified-message
WHATSAPP_SESSION_NAME=
# Optional: scheduled report emails, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM=

# ── Generated by setup.sh — don't change after the first start ────────────
POSTGRES_PASSWORD=
JWT_SECRET=
UPDATER_TOKEN=
# Also set as the RELEASE_WEBHOOK_SECRET secret in GitHub (Settings → Secrets → Actions).
RELEASE_WEBHOOK_SECRET=

# ── Memory caps, so F Cartel can never starve your other sites ─────────────
POSTGRES_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=768m
WEB_MEM_LIMIT=512m
