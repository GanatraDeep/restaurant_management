# F Cartel — __DOMAIN__ → the F Cartel web container on 127.0.0.1:__PORT__.
# Added by deploy/setup.sh. This block only answers for __DOMAIN__, so every
# other site on this server is unaffected; certbot adds the HTTPS lines here.

# Namespaced so it can't collide with a $connection_upgrade map defined by
# another site's config.
map $http_upgrade $fcartel_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
__IPV6_LISTEN__
    server_name __DOMAIN__;

    # Menu photos and logos (the app allows up to 5 MB per image).
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Appends the real client address; the API trusts only private hops
        # in front of it, so this is what rate limiting keys on.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Live order / kitchen updates (WebSocket).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $fcartel_connection_upgrade;
        proxy_read_timeout 120s;
    }
}
