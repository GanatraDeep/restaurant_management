# Copy to .env before running `docker compose up`. Compose reads .env from
# this directory automatically — never commit the real .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:1995
HOST_PORT=1995

# Leave unset/false for the default plain-HTTP setup (LAN IP, localhost, a
# VPS reached over http://). Only set to "true" once this app is actually
# served over HTTPS (a reverse proxy, a Cloudflare Tunnel, etc.) — the
# session cookie is marked Secure when this is true, and browsers silently
# refuse to store a Secure cookie on a plain http:// origin, which locks
# every user out with "Unauthorized" even though login appears to succeed.
COOKIE_SECURE=false

# Optional: makes THIS server a sync hub that Windows/desktop installs can
# two-way sync with (Settings → Server Sync on the other PC). Use a long random
# value (openssl rand -hex 24) and leave unset on installs that are not the hub.
# SYNC_API_KEY=

# F Cartel platform billing. Emails listed here get the super-admin console
# at /admin (plans, free trials, every restaurant's subscription). Sign up
# with one of these emails first, then visit /admin.
# SUPER_ADMIN_EMAILS=you@example.com

# Razorpay (Dashboard → Account & Settings → API Keys). Without these,
# free plans and trials still work; paid plans show "payments not set up".
# Add a webhook in the Razorpay Dashboard pointing at
#   https://<your-domain>/api/v1/billing/razorpay/webhook
# for the payment.captured, order.paid and payment.failed events, and put the
# secret you chose there in RAZORPAY_WEBHOOK_SECRET.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
